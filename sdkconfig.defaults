# CAN-WIFI project defaults (applied on full sdkconfig regeneration)
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash (16MB, DIO 80MHz) ----
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---- PSRAM: N16R8 module, octal 8MB ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Allocate WiFi/LWIP buffers from PSRAM first
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Logging: default INFO, no ANSI colors ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_COLORS is not set

# HTTPS mail increases firmware size; app offset and NVS layout stay compatible.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Both UART0 and board USB-Serial/JTAG accept configuration commands.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
